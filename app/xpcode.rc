#include <windows.h>
#include "resource.h"

IDD_SETTINGS DIALOGEX 0, 0, 250, 150
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "XPCode Settings"
FONT 8, "Tahoma"
BEGIN
    LTEXT "Host:", -1, 10, 12, 50, 8
    EDITTEXT IDC_SET_HOST, 70, 10, 170, 12, ES_AUTOHSCROLL
    LTEXT "Port:", -1, 10, 34, 50, 8
    EDITTEXT IDC_SET_PORT, 70, 32, 60, 12, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "Model:", -1, 10, 56, 50, 8
    EDITTEXT IDC_SET_MODEL, 70, 54, 170, 12, ES_AUTOHSCROLL
    LTEXT "Project folder:", -1, 10, 78, 60, 8
    EDITTEXT IDC_SET_WORKDIR, 70, 76, 130, 12, ES_AUTOHSCROLL
    PUSHBUTTON "Browse...", IDC_SET_BROWSE, 205, 75, 35, 14
    DEFPUSHBUTTON "OK", IDC_SET_OK, 110, 125, 55, 14
    PUSHBUTTON "Cancel", IDC_SET_CANCEL, 175, 125, 55, 14
END
